{
  "name": "durak-perevodnoy",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "Durak WS + тестовый клиент",
      "onAutoForward": "notify"
    }
  },
  "waitFor": "postCreateCommand",
  "onCreateCommand": "bash .devcontainer/ensure-sshd.sh",
  "postCreateCommand": "npm install",
  "postStartCommand": "bash .devcontainer/ensure-sshd.sh"
}
